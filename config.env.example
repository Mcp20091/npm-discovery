# /etc/npm-discovery/config.env
# These are the starting values. Every setting here can also be changed in the web page
# (Settings tab); values saved there override this file.
# Wrap values containing spaces or special characters in double quotes.

# --- Nginx Proxy Manager ---
NPM_URL="http://192.168.1.10:81"
NPM_EMAIL="admin@example.com"
NPM_PASSWORD="changeme"
# Set to false if NPM_URL is https with a self-signed certificate
NPM_VERIFY_TLS=true

# --- Discovery ---
# Comma separated CIDR ranges
SCAN_SUBNETS="192.168.1.0/24"
# IPs/ranges to skip, comma separated, e.g. "192.168.1.1,192.168.1.50-60,192.168.1.128/28"
SCAN_EXCLUDE=""
# Base domain; proxy hosts become <subdomain>.<BASE_DOMAIN>
BASE_DOMAIN="mydomain.com"
# Hours between scheduled scans (0 = only scan when you click Scan now)
SCAN_INTERVAL_HOURS=0
# Run a scan shortly after the service starts
SCAN_ON_START=false
# Ports to check (comma separated)
SCAN_PORTS="80,81,443,1880,2283,2342,3000,3001,3002,3030,3333,4000,4200,4533,5000,5001,5006,5055,5173,5230,5380,5601,5678,6052,6767,7474,7575,7860,7861,7878,8000,8001,8006,8007,8008,8010,8080,8081,8082,8083,8086,8088,8096,8112,8123,8181,8188,8191,8200,8384,8443,8444,8500,8501,8686,8787,8888,8920,8989,9000,9001,9090,9091,9117,9443,9696,10000,13378,19999,32400,42000-42009"
# true = scan all 65535 ports (much slower)
SCAN_ALL_PORTS=false
# true = slower, rate-limited scan that is less likely to trigger security software
SCAN_GENTLE=false
# Seconds to wait for each HTTP/HTTPS probe
PROBE_TIMEOUT=5

# --- Web UI ---
WEB_HOST=0.0.0.0
WEB_PORT=8080
