[Unit]
Description=NPM Discovery
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=npm-discovery
Group=npm-discovery
EnvironmentFile=/etc/npm-discovery/config.env
Environment=DATA_DIR=/var/lib/npm-discovery
WorkingDirectory=/opt/npm-discovery
ExecStart=/opt/npm-discovery/venv/bin/python -m app.main
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/npm-discovery
ProtectHome=true

[Install]
WantedBy=multi-user.target
